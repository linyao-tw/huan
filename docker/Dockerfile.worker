# syntax=docker/dockerfile:1

FROM node:24.20-bookworm-slim AS builder

ENV PNPM_HOME="/pnpm" \
	PATH="/pnpm:$PATH" \
	CI=true
RUN corepack enable

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm build:packages && pnpm --filter @huan/worker build
RUN pnpm install --frozen-lockfile --prod

FROM node:24.20-bookworm-slim AS runtime

ENV NODE_ENV=production \
	PNPM_HOME="/pnpm" \
	PATH="/pnpm:$PATH" \
	FFMPEG_PATH=/usr/bin/ffmpeg \
	FFPROBE_PATH=/usr/bin/ffprobe \
	WORKER_TMP_DIR=/var/tmp/huan \
	WORKER_HEALTH_PORT=4001
RUN corepack enable

# ffmpeg 是 Worker 唯一的系統相依。用 apt 安裝發行版套件，避免把靜態編譯的
# 二進位檔綁進映像後在 arm64 上找不到對應版本。
RUN apt-get update \
	&& apt-get install --no-install-recommends -y ffmpeg \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder --chown=node:node /app /app

# OpenTelemetry 要在應用程式之前載入，才攔得到 http、pino 與 AWS SDK。
# 用 NODE_OPTIONS 而不是寫進 CMD：Zeabur 會用自己的啟動指令覆蓋 CMD，環境變數不受影響。
# 同一個容器裡的其他 node 行程（migration、健康檢查）也會載入它，但只有主程式會真的啟動；
# 沒有設定 OTEL_EXPORTER_OTLP_ENDPOINT 時什麼都不做。
ENV NODE_OPTIONS="--import=/app/apps/worker/dist/instrumentation.js"

# 放在最後：每個 commit 都不同，放前面會讓後面每一層的快取都失效。
# 它會成為 trace 與指標上的 service.version，查「這個錯誤是哪一版開始的」用得到。
ARG HUAN_VERSION=dev
ENV HUAN_VERSION=${HUAN_VERSION}

RUN mkdir -p /var/tmp/huan && chown node:node /var/tmp/huan
USER node

EXPOSE 4001

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
	CMD node -e "fetch('http://127.0.0.1:'+(process.env.WORKER_HEALTH_PORT||4001)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/worker/dist/main.js"]
