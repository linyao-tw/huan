{
	"name": "@huan/device",
	"version": "0.1.0",
	"private": true,
	"description": "HUAN Device：Electron 播放器，負責配對、離線播放、排程執行與素材同步",
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"build": "electron-vite build",
		"dev": "electron-vite dev",
		"package": "electron-vite build && electron-builder",
		"package:linux": "electron-vite build && electron-builder --linux --x64 --arm64",
		"package:mac": "electron-vite build && electron-builder --mac --x64 --arm64",
		"package:win": "electron-vite build && electron-builder --win --x64 --arm64",
		"start": "electron-vite preview",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@huan/device-core": "workspace:*",
		"@huan/layout-engine": "workspace:*",
		"@huan/protocol": "workspace:*",
		"@huan/shared": "workspace:*",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@linyao.tw/ui": "1.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"electron": "^44.2.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"vite": "^8.2.2"
	}
}
