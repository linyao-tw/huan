---
import Icon from "@/components/Icon.astro";
---

{
	/*
	對話框刻意放在 body 尾端，不放在頁首裡。
	頁首用了 backdrop-filter，那會讓它成為 position: fixed 子元素的包含區塊 ——
	對話框會被裁進頁首那 64px 高的盒子裡，只露出一條白邊。
*/
}
<div class="search-overlay" id="search-overlay" hidden>
	<div class="search-dialog" role="dialog" aria-modal="true" aria-label="搜尋文件">
		<div class="search-dialog__header">
			<Icon name="magnifying-glass" weight="bold" size="1.125rem" />
			<input class="search-dialog__input" id="search-input" type="search" placeholder="搜尋文件…" autocomplete="off" spellcheck="false" aria-label="搜尋文件" />
			<kbd class="search-dialog__esc">Esc</kbd>
		</div>
		<div class="search-dialog__results" id="search-results" role="listbox" aria-label="搜尋結果"></div>
	</div>
</div>

<style>
	.search-overlay {
		position: fixed;
		inset: 0;
		z-index: 60;
		display: flex;
		justify-content: center;
		/* 不要 stretch：預設的 align-items 會把對話框拉滿整個視窗高度。 */
		align-items: flex-start;
		padding: 12vh var(--space-4) var(--space-4);
		background: var(--background-backdrop);
	}

	.search-overlay[hidden] {
		display: none;
	}

	.search-dialog {
		display: flex;
		flex-direction: column;
		width: min(40rem, 100%);
		max-height: 70vh;
		background: var(--background-modal);
		border: var(--border-width-hairline) solid var(--divider-main);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-overlay);
		overflow: hidden;
	}

	.search-dialog__header {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-4);
		border-bottom: var(--border-width-hairline) solid var(--divider-subtle);
		color: var(--text-muted);
	}

	.search-dialog__input {
		flex: 1;
		min-width: 0;
		background: transparent;
		border: 0;
		color: var(--text-main);
		font-family: inherit;
		font-size: var(--font-size-md);
		outline: none;
	}

	/* type="search" 的原生清除鈕不吃我們的樣式，而且在深色下是刺眼的藍色。 */
	.search-dialog__input::-webkit-search-cancel-button,
	.search-dialog__input::-webkit-search-decoration {
		appearance: none;
	}

	.search-dialog__esc {
		padding: 0 var(--space-1);
		border: var(--border-width-hairline) solid var(--divider-main);
		border-radius: var(--radius-2xs);
		font-family: var(--font-family-mono);
		font-size: var(--font-size-xs);
	}

	.search-dialog__results:not(:empty) {
		padding: var(--space-2);
		overflow-y: auto;
	}

	:global(.search-result) {
		display: block;
		padding: var(--space-3);
		border-radius: var(--radius-sm);
		color: var(--text-main);
		text-decoration: none;
	}

	:global(.search-result:hover),
	:global(.search-result[data-active="true"]) {
		background: var(--background-selected);
	}

	:global(.search-result__title) {
		display: block;
		color: var(--text-title);
		font-weight: var(--font-weight-medium);
	}

	:global(.search-result__excerpt) {
		display: block;
		margin-block-start: var(--space-1);
		color: var(--text-secondary);
		font-size: var(--font-size-sm);
		/* 摘要可能很長，限制在兩行以內，避免一筆結果佔滿整個面板。 */
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	:global(.search-result__excerpt mark) {
		background: var(--control-selected-muted);
		color: var(--text-accent);
	}

	:global(.search-empty) {
		padding: var(--space-6);
		color: var(--text-secondary);
		text-align: center;
	}

	@media (max-width: 900px) {
		.search-trigger__label,
		.search-trigger__key {
			display: none;
		}
	}
</style>
