---
import Icon from "@/components/Icon.astro";
---

<button class="search-trigger" id="search-trigger" type="button" aria-haspopup="dialog" aria-label="搜尋文件">
	<Icon name="magnifying-glass" weight="bold" size="1rem" />
	<span class="search-trigger__label">搜尋文件</span>
	<kbd class="search-trigger__key">⌘K</kbd>
</button>

<style>
	.search-trigger {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		height: var(--control-height-compact-sm);
		padding-inline: var(--space-3);
		background: var(--control-surface);
		border: var(--border-width-hairline) solid var(--border-control);
		border-radius: var(--radius-sm);
		color: var(--control-placeholder);
		cursor: pointer;
		font-family: inherit;
		font-size: var(--font-size-sm);
	}

	.search-trigger:hover {
		border-color: var(--border-control-hover);
		color: var(--text-secondary);
	}

	.search-trigger__key {
		padding: 0 var(--space-1);
		border: var(--border-width-hairline) solid var(--divider-main);
		border-radius: var(--radius-2xs);
		color: var(--text-muted);
		font-family: var(--font-family-mono);
		font-size: var(--font-size-xs);
	}

	/* 窄螢幕只留放大鏡：標籤與快捷鍵在手機上都沒有意義，還會擠掉其他操作。 */
	@media (max-width: 900px) {
		.search-trigger__label,
		.search-trigger__key {
			display: none;
		}
	}
</style>
