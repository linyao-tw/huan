---
import type { MarkdownHeading } from "astro";
import Icon from "@/components/Icon.astro";
import SearchDialog from "@/components/SearchDialog.astro";
import SearchTrigger from "@/components/SearchTrigger.astro";
import Sidebar from "@/components/Sidebar.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { hrefFor, neighbours, SECTIONS, sectionFor } from "@/lib/navigation";
import "@/styles/docs.css";

interface Props {
	id: string;
	title: string;
	description?: string | undefined;
	headings: MarkdownHeading[];
}

const { id, title, description, headings } = Astro.props;

const section = sectionFor(id);
const { previous, next } = neighbours(id);
const canonical = new URL(hrefFor(id), Astro.site).href;
const pageTitle = id === "index" ? "HUAN 讙 文件" : `${title} — HUAN 讙`;
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={pageTitle} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		{/* 每一頁都有對應的 Markdown，llms.txt 指向的就是它。 */}
		<link rel="alternate" type="text/markdown" href={`${hrefFor(id) === "/" ? "/index" : hrefFor(id)}.md`} />

		{
			/*
			在第一次繪製前決定主題，避免深色使用者看到一閃而過的亮色。
			這段必須是同步內嵌腳本，放到外部檔案就來不及了。
		*/
		}
		<script is:inline>
			(() => {
				const stored = (() => {
					try {
						return localStorage.getItem("huan-docs-theme");
					} catch {
						return null;
					}
				})();
				const theme = stored === "light" || stored === "dark" ? stored : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
				document.documentElement.setAttribute("data-lyds-theme", theme);
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
	</head>

	<body>
		<a class="skip-link" href="#content">跳到主要內容</a>

		<header class="site-header">
			<div class="site-header__rail">
				<button class="icon-button menu-button" id="menu-button" type="button" aria-label="開啟導覽選單" aria-expanded="false" aria-controls="sidebar">
					<Icon name="list" weight="bold" />
				</button>

				<a class="site-brand" href="/">
					<span>HUAN</span>
					<span class="site-brand__han">讙</span>
				</a>

				<nav class="site-sections" aria-label="文件區塊">
					{
						SECTIONS.map(item => (
							<a class="site-sections__link" href={hrefFor(item.entry)} aria-current={item.label === section.label ? "true" : undefined}>
								{item.label}
							</a>
						))
					}
				</nav>

				<div class="site-header__spacer"></div>

				<div class="site-header__actions">
					<SearchTrigger />
					<ThemeToggle />
					<a class="icon-button" href="https://github.com/linyao-tw/huan" rel="noreferrer noopener" target="_blank" aria-label="在 GitHub 上檢視原始碼">
						<Icon name="github-logo" weight="bold" />
					</a>
				</div>
			</div>
		</header>

		<div class="shell">
			<Sidebar nav={section.nav} currentId={id} />

			<div class="page">
				<main class="content" id="content">
					<article data-pagefind-body>
						<p class="content__eyebrow">{section.label}</p>
						<h1>{title}</h1>
						{
							/*
							description 取自內文第一段，只用於 meta 標籤、llms.txt 與搜尋結果。
							再渲染一次就會和內文重複，因此版面上不顯示；
							內文自己的第一段由 CSS 放大成前言。
						*/
						}
						<div class="prose">
							<slot />
						</div>
					</article>

					{
						(previous || next) && (
							<nav class="page-nav" aria-label="上下頁">
								{previous && (
									<a class="page-nav__link" href={hrefFor(previous.id)}>
										<span class="page-nav__label">上一頁</span>
										<span class="page-nav__title">{previous.label}</span>
									</a>
								)}
								{next && (
									<a class="page-nav__link page-nav__link--next" href={hrefFor(next.id)}>
										<span class="page-nav__label">下一頁</span>
										<span class="page-nav__title">{next.label}</span>
									</a>
								)}
							</nav>
						)
					}
				</main>

				<TableOfContents headings={headings} />
			</div>
		</div>

		<SearchDialog />

		<script>
			import { initDocs } from "@/scripts/docs";
			initDocs();
		</script>
	</body>
</html>
