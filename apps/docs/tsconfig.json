{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"noEmit": true,
		"noUnusedLocals": false,
		"types": ["node"],
		"paths": {
			"@/*": ["./theme/*"]
		}
	},
	"include": ["theme", "rspress.config.ts", "docs/**/*.tsx"]
}
