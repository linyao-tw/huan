{
	"name": "@huan/device-sim",
	"version": "0.1.0",
	"private": true,
	"description": "HUAN 模擬裝置：無 GUI 的裝置代理，用於開發與端對端測試",
	"type": "module",
	"main": "./dist/main.js",
	"bin": {
		"huan-device-sim": "./dist/main.js"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsx src/main.ts",
		"start": "node dist/main.js",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@huan/device-core": "workspace:*",
		"@huan/protocol": "workspace:*",
		"@huan/shared": "workspace:*"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"tsx": "^4.23.13"
	}
}
