{
	"name": "@huan/worker",
	"version": "0.1.0",
	"private": true,
	"description": "HUAN Worker：以 PostgreSQL 為佇列的 FFmpeg 轉檔與素材回收程序",
	"type": "module",
	"main": "./dist/main.js",
	"scripts": {
		"build": "tsup",
		"dev": "tsx watch src/main.ts",
		"start": "node dist/main.js",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1127.0",
		"@huan/config": "workspace:*",
		"@huan/db": "workspace:*",
		"@huan/protocol": "workspace:*",
		"@huan/shared": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"pino-pretty": "^13.1.3",
		"tsup": "^8.5.1",
		"tsx": "^4.23.13"
	}
}
