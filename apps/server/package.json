{
	"name": "@huan/server",
	"version": "0.1.0",
	"private": true,
	"description": "HUAN Server：Fastify REST API、WebSocket 控制通道與 Admin 靜態服務",
	"type": "module",
	"main": "./dist/main.js",
	"scripts": {
		"admin:create": "tsx src/cli/create-admin.ts",
		"build": "tsup",
		"db:generate": "pnpm --filter @huan/db db:generate",
		"db:migrate": "tsx src/cli/migrate.ts",
		"db:seed": "tsx src/cli/seed.ts",
		"dev": "tsx watch --env-file-if-exists=../../.env --import ./src/instrumentation.ts src/main.ts",
		"start": "node dist/main.js",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1127.0",
		"@aws-sdk/s3-request-presigner": "^3.1127.0",
		"@fastify/cookie": "^11.1.2",
		"@fastify/cors": "^11.3.0",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/static": "^10.1.3",
		"@fastify/swagger": "^9.8.1",
		"@fastify/websocket": "^11.3.0",
		"@huan/config": "workspace:*",
		"@huan/db": "workspace:*",
		"@huan/layout-engine": "workspace:*",
		"@huan/protocol": "workspace:*",
		"@huan/shared": "workspace:*",
		"@huan/telemetry": "workspace:*",
		"@node-rs/argon2": "^2.2.0",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/core": "2.11.0",
		"@scalar/fastify-api-reference": "^1.67.0",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.12.3",
		"fastify-type-provider-zod": "^7.0.0",
		"openapi-types": "^12.1.3",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@opentelemetry/context-async-hooks": "2.11.0",
		"@opentelemetry/sdk-trace-base": "2.11.0",
		"@types/qrcode": "^1.5.6",
		"pino-pretty": "^13.1.3",
		"tsup": "^8.5.1",
		"tsx": "^4.23.13"
	}
}
