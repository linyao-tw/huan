# ── 共用 ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=huan
POSTGRES_PASSWORD=change-me-in-your-own-env
POSTGRES_DB=huan
POSTGRES_PORT=5432
DATABASE_URL=postgres://huan:change-me-in-your-own-env@localhost:5432/huan

# ── RustFS（S3 相容物件儲存）─────────────────────────────────────────────
RUSTFS_PORT=9000
S3_ENDPOINT=http://localhost:9000
# 瀏覽器與裝置實際連得到的位址。在 Docker 內部與外部不同時才需要另外設定。
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=huan
S3_ACCESS_KEY_ID=huanadmin
S3_SECRET_ACCESS_KEY=change-me-in-your-own-env
S3_FORCE_PATH_STYLE=true

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4000
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
# 要信任的反向代理，決定 request.ip 從哪裡取（速率限制與登入節流都以它為鍵）。
# 預設 false＝只信 socket 來源、不看 X-Forwarded-For。部署在代理後面時設成代理的
# 跳數（例如 1）或它的 IP/CIDR，只信任那一層，否則偽造 XFF 就能繞過節流。
# TRUST_PROXY=false
SESSION_COOKIE_NAME=huan_session
SESSION_TTL_HOURS=336
# production 會自動要求 Secure cookie；本機沒有 TLS 時保持未設定即可。
# SESSION_COOKIE_SECURE=false
TOTP_ISSUER=HUAN
# 加密 TOTP 密鑰用的金鑰，base64 的 32 bytes（用 `openssl rand -base64 32` 產生）。
# production 一定要設，沒設 Server 會拒絕啟動；開發環境沒設會退回一把公開的測試金鑰。
# TOTP_SECRET_KEY=change-me-openssl-rand-base64-32
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SIGNED_URL_TTL_SECONDS=900
DEVICE_HEARTBEAT_SECONDS=60
DEVICE_FALLBACK_SYNC_SECONDS=300
DEVICE_MAX_CONCURRENT_DOWNLOADS=3
# 設定後 Server 會直接靜態服務 Admin 的 production build。
# ADMIN_DIST_DIR=/app/admin

# ── Worker ───────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
WORKER_JOB_MAX_ATTEMPTS=3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Admin（Vite）─────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000

# ── 正式部署：Caddy 反向代理 ─────────────────────────────────────────────
# 用 docker/compose.caddy.yaml 疊上去時需要這幾個：
#   docker compose -f docker/compose.yaml -f docker/compose.caddy.yaml up -d
#
# 兩個對外網域，後端與物件儲存分開。物件儲存要獨立網域，因為簽章網址的 host
# 就是它，換網域等於換簽章對象。
# APP_DOMAIN=huan.example.com
# STORAGE_DOMAIN=storage.huan.example.com
# CADDY_EMAIL=ops@example.com
#
# 對應的服務設定（正式值）：
# PUBLIC_URL=https://huan.example.com
# CORS_ORIGINS=https://huan.example.com
# S3_PUBLIC_ENDPOINT=https://storage.huan.example.com   # 簽章網址的 host，要等於 STORAGE_DOMAIN
# S3_ENDPOINT=http://rustfs:9000                        # server 自己存取用的內部位址，維持不變
# TRUST_PROXY=1                                         # 只信任 Caddy 這一跳
# SESSION_COOKIE_SECURE=true                            # 對外是 HTTPS
# TOTP_SECRET_KEY=（openssl rand -base64 32 產生，production 必填）

# ── 可觀測性（選填）─────────────────────────────────────────────────────
# 設定了收件端，server 與 worker 才會以 OpenTelemetry 送出 trace、log 與 metric；
# 沒設定時 SDK 完全不載入。收件端可以用 docker/observability 自己起一組。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
