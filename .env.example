# ── 共用 ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=huan
POSTGRES_PASSWORD=change-me-in-your-own-env
POSTGRES_DB=huan
POSTGRES_PORT=5432
DATABASE_URL=postgres://huan:change-me-in-your-own-env@localhost:5432/huan

# ── RustFS（S3 相容物件儲存）─────────────────────────────────────────────
RUSTFS_PORT=9000
S3_ENDPOINT=http://localhost:9000
# 瀏覽器與裝置實際連得到的位址。在 Docker 內部與外部不同時才需要另外設定。
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=huan
S3_ACCESS_KEY_ID=huanadmin
S3_SECRET_ACCESS_KEY=change-me-in-your-own-env
S3_FORCE_PATH_STYLE=true

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4000
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=huan_session
SESSION_TTL_HOURS=336
# production 會自動要求 Secure cookie；本機沒有 TLS 時保持未設定即可。
# SESSION_COOKIE_SECURE=false
TOTP_ISSUER=HUAN
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SIGNED_URL_TTL_SECONDS=900
DISTRIBUTION_RETENTION_HOURS=24
DEVICE_HEARTBEAT_SECONDS=60
DEVICE_FALLBACK_SYNC_SECONDS=300
DEVICE_MAX_CONCURRENT_DOWNLOADS=3
# 設定後 Server 會直接靜態服務 Admin 的 production build。
# ADMIN_DIST_DIR=/app/admin

# ── Worker ───────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
WORKER_JOB_MAX_ATTEMPTS=3
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Admin（Vite）─────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
