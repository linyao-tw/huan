{
	"name": "huan",
	"version": "0.1.0",
	"private": true,
	"description": "HUAN 讙 — 跨平台的雲端媒體播放與數位看板系統",
	"type": "module",
	"scripts": {
		"build": "pnpm build:packages && pnpm build:apps",
		"build:apps": "pnpm --filter @huan/server --filter @huan/worker --filter @huan/admin --filter @huan/device-sim build",
		"build:packages": "pnpm --filter \"./packages/*\" build",
		"db:generate": "pnpm --filter @huan/server db:generate",
		"db:migrate": "pnpm --filter @huan/server db:migrate",
		"db:seed": "pnpm --filter @huan/server db:seed",
		"dev": "pnpm build:packages && concurrently -n server,worker,admin -c blue,magenta,green \"pnpm dev:server\" \"pnpm dev:worker\" \"pnpm dev:admin\"",
		"dev:admin": "pnpm --filter @huan/admin dev",
		"dev:device": "pnpm --filter @huan/device dev",
		"dev:device-sim": "pnpm --filter @huan/device-sim dev",
		"dev:server": "pnpm --filter @huan/server dev",
		"dev:worker": "pnpm --filter @huan/worker dev",
		"docker:build": "docker compose -f docker/compose.yaml build",
		"docker:down": "docker compose -f docker/compose.yaml down",
		"docker:logs": "docker compose -f docker/compose.yaml logs -f",
		"docker:up": "docker compose -f docker/compose.yaml up -d",
		"docs:screenshots": "pnpm --filter @huan/e2e screenshots",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preinstall": "npx only-allow pnpm",
		"prepare": "sh -c 'if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi'",
		"test": "pnpm build:packages && pnpm -r --workspace-concurrency=1 --if-present test",
		"test:e2e": "pnpm --filter @huan/e2e e2e",
		"typecheck": "pnpm build:packages && pnpm -r --if-present typecheck"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"concurrently": "^10.0.5",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
	"engines": {
		"node": ">=22.13.0"
	}
}
